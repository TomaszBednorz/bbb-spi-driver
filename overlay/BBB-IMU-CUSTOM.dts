/dts-v1/;
/plugin/;

#include <dt-bindings/pinctrl/am33xx.h>

/ {
	/*
	* Disable default pins configuration.
	*/
	fragment@0 {
		target = <&ocp>;
		__overlay__ {
			P9_28_pinmux { status = "disabled"; };
			P9_29_pinmux { status = "disabled"; };
			P9_30_pinmux { status = "disabled"; };
			P9_31_pinmux { status = "disabled"; };
		};
	};

	/*
	* Set pin configuration for SPI1.
	*/
	fragment@1 {
		target = <&am33xx_pinmux>;
		__overlay__ {
			bb_spi1_pins: pinmux_bb_spi1_pins {
				pinctrl-single,pins = <
					AM33XX_PADCONF(AM335X_PIN_MCASP0_ACLKX, PIN_INPUT, MUX_MODE3)
					AM33XX_PADCONF(AM335X_PIN_MCASP0_FSX, PIN_INPUT, MUX_MODE3)
					AM33XX_PADCONF(AM335X_PIN_MCASP0_AXR0, PIN_INPUT, MUX_MODE3)
					AM33XX_PADCONF(AM335X_PIN_MCASP0_AHCLKR, PIN_INPUT, MUX_MODE3)
				>;
			};
		};
	};

	fragment@2 {
		target = <&spi1>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&bb_spi1_pins>;

            imu@0 {
                compatible = "custom,imu-lsm6dso";
                reg = <0>;
                
                spi-max-frequency = <10000000>; /* 10 MHz */
                spi-bits-per-word = <8>;
            };
		};
	};
};
